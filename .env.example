# IMovies Environment Configuration
# Copy to .env for local development. Never commit real credentials.

PORT=3000
NODE_ENV=development

# Optional locally; required for production. Use your own MongoDB Atlas URI.
MONGODB_URI=

# Use a long, unique random secret in production.
JWT_SECRET=

# Required when initializing an empty production database.
ADMIN_EMAIL=
ADMIN_PASSWORD=

CLIENT_URL=http://localhost:3000
GEMINI_API_KEY=
APP_URL=
