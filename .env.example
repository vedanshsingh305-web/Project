# IMovies Environment Configuration
# Copy this file to .env for local development. Never commit real credentials.

PORT=3000
NODE_ENV=development

# Optional for local development; required in production.
# Create a MongoDB Atlas database and paste its connection URI here.
MONGODB_URI=

# Use a long, unique random secret in production (at least 32 characters).
JWT_SECRET=

# Public URL of this app, if needed by integrations.
CLIENT_URL=http://localhost:3000

# Optional Gemini API key; configure only if the feature is used.
GEMINI_API_KEY=

# Optional public app URL.
APP_URL=
